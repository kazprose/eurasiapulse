{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Base" },
				{ "slug": "ink", "color": "#121212", "name": "Ink" },
				{ "slug": "ink-2", "color": "#5A5A5A", "name": "Secondary ink" },
				{ "slug": "rule", "color": "#E2E2E2", "name": "Rule" },
				{ "slug": "accent", "color": "#B80000", "name": "Accent" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1240px"
		},
		"spacing": {
			"customSpacingSize": false,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "size": "8px", "name": "1" },
				{ "slug": "20", "size": "16px", "name": "2" },
				{ "slug": "30", "size": "24px", "name": "3" },
				{ "slug": "40", "size": "32px", "name": "4" },
				{ "slug": "50", "size": "48px", "name": "5" }
			],
			"units": [ "px", "rem", "em", "%" ]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": false,
