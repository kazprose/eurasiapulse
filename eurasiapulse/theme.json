	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "1.1875rem", "lineHeight": "1.6" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--ink)" }, ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "600", "lineHeight": "1.2" } }
		}
	}
